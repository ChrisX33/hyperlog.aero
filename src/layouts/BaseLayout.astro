---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { existsSync } from 'fs';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Blockchain pilot logbook and digital credentials infrastructure. Tamper-evident flight records with multi-source verification. Built by JetLink Technologies.',
  ogImage = '/og-image.png',
} = Astro.props;

const MAINTENANCE_FILE = '/tmp/hyperlog-maintenance';
const maintenance = existsSync(MAINTENANCE_FILE);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="JetLink Technologies Ltd" />
  <link rel="canonical" href={canonicalURL.toString()} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.toString()} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta property="og:site_name" content="HyperLog" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Analytics preconnect -->
  <link rel="dns-prefetch" href="https://analytics.jetlink-tech.com" />
  <link rel="preconnect" href="https://analytics.jetlink-tech.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

  <!-- Umami (cookieless) -->
  <script defer src="https://analytics.jetlink-tech.com/script.js" data-website-id="46ed6cea-63d9-4ff2-937e-e7293eb46334"></script>

  <title>{maintenance ? 'HyperLog — Maintenance' : title}</title>

  <!-- JSON-LD Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "JetLink Technologies Ltd",
    "url": "https://hyperlog.aero",
    "logo": "https://hyperlog.aero/logo/logo-icon.svg",
    "description": "Aviation-native software company building blockchain pilot logbook and digital credentials infrastructure.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Level 9, Berkeley Square House, Berkeley Square",
      "addressLocality": "London",
      "postalCode": "W1J 6BY",
      "addressCountry": "GB"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@hyperlog.aero",
      "contactType": "General Enquiry"
    },
    "founders": [
      {
        "@type": "Person",
        "name": "Christian Charalambous",
        "jobTitle": "CEO & Founder"
      }
    ],
    "sameAs": [
      "https://www.linkedin.com/in/christiancharalambous/"
    ]
  })} />

  {maintenance && (
    <style>{`
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #0d0d14; font-family: 'Inter', sans-serif; color: #e8e8f0; }
      .hl-maint {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .hl-maint__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 480px;
        width: 100%;
      }
      .hl-maint__logo { width: 180px; height: auto; display: block; margin-bottom: 40px; }
      .hl-maint__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(6,182,212,0.1);
        border: 1px solid rgba(6,182,212,0.3);
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 500;
        color: #06b6d4;
        margin-bottom: 32px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .hl-maint__dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #06b6d4; flex-shrink: 0;
        animation: hl-pulse 2s infinite;
      }
      @keyframes hl-pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
      .hl-maint h1 { font-size: 2rem; font-weight: 700; color: #fff; margin: 0 0 16px; letter-spacing: -0.02em; }
      .hl-maint p { font-size: 1rem; color: #8888a0; line-height: 1.6; margin: 0 0 40px; }
      .hl-maint__divider { width: 40px; height: 2px; background: rgba(6,182,212,0.4); }
    `}</style>
  )}
</head>
<body class={maintenance ? '' : 'min-h-screen flex flex-col'}>
  {maintenance ? (
    <div class="hl-maint">
      <div class="hl-maint__inner">
        <img src="/logo/logo-full-on-dark.svg" alt="HyperLog" class="hl-maint__logo" />
        <div class="hl-maint__badge">
          <div class="hl-maint__dot"></div>
          Scheduled Maintenance
        </div>
        <h1>Back Shortly</h1>
        <p>HyperLog is currently undergoing maintenance. We will be back online shortly.</p>
        <div class="hl-maint__divider"></div>
      </div>
    </div>
  ) : (
    <>
      <slot />
      <CookieBanner />
    </>
  )}

  <!-- Poll for maintenance status changes — reload when state flips -->
  <script define:vars={{ maintenance }}>
    setInterval(function() {
      fetch('/api/maintenance')
        .then(function(r) { return r.json(); })
        .then(function(d) { if (Boolean(d.maintenance) !== Boolean(maintenance)) location.reload(); })
        .catch(function() {});
    }, 5000);
  </script>

  <!-- Google Analytics - consent-based -->
  {!maintenance && (
    <script>
      function loadGA() {
        if (document.getElementById('ga-script')) return;
        const s = document.createElement('script');
        s.id = 'ga-script';
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-WPY1K6J3W0';
        document.head.appendChild(s);
        s.onload = () => {
          (window as any).dataLayer = (window as any).dataLayer || [];
          function gtag(...args: any[]) { (window as any).dataLayer.push(args); }
          gtag('js', new Date());
          gtag('config', 'G-WPY1K6J3W0');
        };
      }
      if (localStorage.getItem('cookie-consent') === 'accepted') loadGA();
      window.addEventListener('cookie-consent-update', (e: any) => {
        if (e.detail === 'accepted') loadGA();
      });
    </script>
  )}
</body>
</html>
