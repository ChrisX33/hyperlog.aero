---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HyperLog - Maintenance</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0d0d14;
      font-family: 'Inter', sans-serif;
      color: #e8e8f0;
      padding: 24px;
    }
    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: 480px;
      width: 100%;
    }
    .logo {
      width: 180px;
      display: block;
      margin-bottom: 40px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(6, 182, 212, 0.1);
      border: 1px solid rgba(6, 182, 212, 0.3);
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 500;
      color: #06b6d4;
      margin-bottom: 32px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #06b6d4;
      flex-shrink: 0;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }
    p {
      font-size: 1rem;
      color: #8888a0;
      line-height: 1.6;
      margin-bottom: 40px;
    }
    .divider {
      width: 40px;
      height: 2px;
      background: rgba(6, 182, 212, 0.4);
    }
  </style>
</head>
<body>
  <div class="container">
    <img src="/logo/logo-full-on-dark.svg" alt="HyperLog" class="logo" />
    <div class="badge">
      <div class="dot"></div>
      Scheduled Maintenance
    </div>
    <h1>Back Shortly</h1>
    <p>HyperLog is currently undergoing maintenance. We will be back online shortly.</p>
    <div class="divider"></div>
  </div>
  <script>
    setInterval(function() {
      fetch('/api/maintenance')
        .then(function(r) { return r.json(); })
        .then(function(d) { if (!d.maintenance) location.reload(); })
        .catch(function() {});
    }, 5000);
  </script>
</body>
</html>
